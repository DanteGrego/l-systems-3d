{
    "version" : "2.0.0",
    "tasks": [
        {
            "label": "Compilar proyecto",
            "command": "powershell",
            "args": [
                "-Command",
                "gcc @(Get-ChildItem -Path . -Filter '*.c' -Recurse | ForEach-Object { $_.FullName }) -o test.exe -I include/ -L lib/ -lraylib -lopengl32 -lgdi32 -lwinmm"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Ejecutar test",
            "command": "test",
            "problemMatcher": []
        }
    ]
}